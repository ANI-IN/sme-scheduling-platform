# Web app environment (Vite exposes only VITE_* variables to the browser).
# Copy to .env.local for local development; set the same names in Cloudflare Pages for production.

# Supabase project URL and the publishable key (sb_publishable_…) (Supabase dashboard → Project Settings → API).
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# Only Google accounts with this email domain may use the app, e.g. yourcompany.com
VITE_COMPANY_EMAIL_DOMAIN=REPLACE_WITH_COMPANY_DOMAIN

# n8n "poke" webhook (WF4 Action runner). It only tells n8n to process queued work; it carries no data.
VITE_N8N_POKE_URL=REPLACE_WITH_N8N_WF4_WEBHOOK_URL

# Local development only: show an email magic-link sign-in (uses the local Supabase mail catcher).
# Never set this in production.
VITE_ENABLE_DEV_LOGIN=false
