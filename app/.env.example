# Web app environment (Vite exposes only VITE_* variables to the browser).
# Copy to .env.local for local development; set the same names in Cloudflare Pages for production.

# Supabase project URL and the publishable key (sb_publishable_…) (Supabase dashboard → Project Settings → API).
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# Your company email domain, for example yourcompany.com. Only preselects the company account on
# Google's sign in screen; the database decides who may sign in (ALLOWED_EMAIL_DOMAIN, see the root .env.example).
VITE_ALLOWED_EMAIL_DOMAIN=REPLACE_WITH_COMPANY_DOMAIN

# n8n "poke" webhook (WF4 Action runner). It only tells n8n to process queued work; it carries no data.
VITE_N8N_POKE_URL=REPLACE_WITH_N8N_WF4_WEBHOOK_URL
# Value of the "Poke secret" header credential in n8n (x-poke-key). Low sensitivity: it only triggers delivery.
VITE_N8N_POKE_KEY=REPLACE_WITH_POKE_SECRET

# The Discord bot's Application ID (Discord Developer Portal, General Information). Not a secret. The app builds the
# bot invite link from it (Settings, Connections, Discord servers). Leave empty to hide the link.
VITE_DISCORD_CLIENT_ID=

# Local development only: show an email link sign in (uses the local Supabase mail catcher).
# Ignored by production builds, and refused by the database unless APP_ENVIRONMENT is Development.
VITE_ENABLE_DEV_LOGIN=false
