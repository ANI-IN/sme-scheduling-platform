# The web app on your own computer, against the hosted Sandbox (docs/CONFIGURATION.md).
# Copy to app/.env.sandbox (ignored by git), add the publishable key and the poke key, then run
#   npm run dev:sandbox
# Nothing here is a real secret: the browser can read every VITE_ value.
VITE_SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SANDBOX_PUBLISHABLE_KEY
VITE_ALLOWED_EMAIL_DOMAIN=yourcompany.com
VITE_N8N_POKE_URL=https://your-instance.app.n8n.cloud/webhook/sandbox-sme-poke
VITE_N8N_POKE_KEY=REPLACE_WITH_THE_POKE_SECRET_SANDBOX_VALUE
VITE_DISCORD_CLIENT_ID=1200000000000000017
VITE_ENABLE_DEV_LOGIN=false
