# Settings for the scripts you run on your own computer. See docs/CONFIGURATION.md for every value.
# Nothing is needed for local development or the tests. For a hosted database, copy this file to .env.production
# (ignored by git) and fill it in. Never commit a filled copy.

# The database the scripts talk to. Secret: it holds the database password.
#   Local stack (printed by `npm run db:start`): postgresql://postgres:postgres@127.0.0.1:55422/postgres
#   Hosted: Supabase, Connect, Session pooler, with your database password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# Your hosted Supabase project ID. `npm run backup` and `npm run clock` refuse any other database.
SUPABASE_PROJECT_REF=

# Written into the database by `npm run configure:production -w scripts`.
# ALLOWED_EMAIL_DOMAIN: the company Google Workspace domain whose accounts may sign in.
# APP_ENVIRONMENT: Development (a database on your own computer only) or Production.
# RESPONSE_BASE_URL: the n8n address the answer buttons open (WF2), https://...
# APP_BASE_URL: the address of the web app, used in "Open the app" links, https://...
ALLOWED_EMAIL_DOMAIN=yourcompany.com
APP_ENVIRONMENT=Development
RESPONSE_BASE_URL=
APP_BASE_URL=

# Optional: Google sign in for the local Supabase stack (supabase/config.toml reads these).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Optional: where `npm run backup` writes (default: Backups/sme-scheduling in your home folder).
BACKUP_DIR=

# Optional: run the Discord checks from your computer instead of n8n (`npm run discord:production -w scripts`).
# Secret. It normally lives only in the n8n credential.
DISCORD_BOT_TOKEN=

# Only for databases that still use the retired "Sandbox" environment: its allow lists. Leave empty.
SANDBOX_ALLOWED_DISCORD_SERVERS=
SANDBOX_ALLOWED_EMAIL_DOMAINS=
