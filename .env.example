# Root environment, for the scripts on your own computer. See docs/CONFIGURATION.md for every value.
# There is one environment, Production (the old Sandbox under a new name). The live settings file is .env.production.
# For a new setup, copy this file to .env.production; it is ignored by git. Never commit a filled copy.
#
# DATABASE_URL: the database the scripts talk to. Secret (it holds the database password).
#   Local stack: postgresql://postgres:postgres@127.0.0.1:55422/postgres (printed by `npm run db:start`).
#   Hosted: Supabase, Connect, Session pooler, with your database password in place of [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# Google sign in for the LOCAL Supabase stack only (supabase/config.toml reads these). Optional.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Written into the database by `npm run configure:production -w scripts`.
# (`npm run configure:sandbox -w scripts` is kept only to roll back the switch to Production.)
# ALLOWED_EMAIL_DOMAIN: the company Google Workspace domain whose accounts may sign in.
# APP_ENVIRONMENT: Development (your computer only) or Production. configure:production sets it for you;
#   Development is refused for a database that is not on this computer.
# RESPONSE_BASE_URL: the n8n address instructors' answer buttons open (WF2), https://...
# APP_BASE_URL: the address of the web app, used in "Open the app" links, https://...
#   Both links are set only here and by the configure script, never from inside the app.
ALLOWED_EMAIL_DOMAIN=
APP_ENVIRONMENT=Development
RESPONSE_BASE_URL=
APP_BASE_URL=

# Old Sandbox allow lists (internal setting names, kept on purpose). Not used in Production; leave them empty.
# SANDBOX_ALLOWED_DISCORD_SERVERS: the ID of the Discord server the old Sandbox could post to.
# SANDBOX_ALLOWED_EMAIL_DOMAINS: email domains the old Sandbox could send to.
SANDBOX_ALLOWED_DISCORD_SERVERS=
SANDBOX_ALLOWED_EMAIL_DOMAINS=

# Optional: run the Discord checks from your own computer instead of n8n (`npm run discord:production -w scripts`).
# DISCORD_BOT_TOKEN: the bot token. Secret: it lives in the n8n credential; only set it here if you use this.
DISCORD_BOT_TOKEN=
