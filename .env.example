# Root environment, used by local tooling only (scripts/mock-run.ts, tests).
# Local Supabase database (printed by `npm run db:start`).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55422/postgres

# Google sign-in for the LOCAL Supabase stack (supabase/config.toml reads these). Optional.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# Who may sign in and which environment this database is (written by `npm run configure -w scripts`).
# ALLOWED_EMAIL_DOMAIN: your company Google Workspace domain, for example yourcompany.com.
# APP_ENVIRONMENT: Development (your computer), Sandbox or Production.
ALLOWED_EMAIL_DOMAIN=REPLACE_WITH_COMPANY_DOMAIN
APP_ENVIRONMENT=Development
