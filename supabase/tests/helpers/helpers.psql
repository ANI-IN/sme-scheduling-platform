-- Test helpers (schema "tests"). Included by every test file *inside* its begin … rollback, so the
-- helpers, like all test data, never stay in the app database.
create extension if not exists pgtap with schema extensions;
create schema if not exists tests;

-- Sign in as an API user with the given email (role authenticated). Use tests.as_postgres() to undo.
create or replace function tests.login_as(p_email text)
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', gen_random_uuid(), 'role', 'authenticated', 'email', p_email)::text, true);
  perform set_config('request.jwt.claim.role', 'authenticated', true);
  execute 'set local role authenticated';
end $$;

create or replace function tests.login_anon()
returns void language plpgsql as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  perform set_config('request.jwt.claim.role', 'anon', true);
  execute 'set local role anon';
end $$;

create or replace function tests.as_postgres()
returns void language plpgsql as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.role', '', true);
end $$;

create or replace function tests.rand_discord()
returns text language sql as $$
  select (100000000000000000 + floor(random() * 800000000000000000))::bigint::text;
$$;

create or replace function tests.company()
returns void language sql as $$
  update public.app_config set company_email_domain = 'example.com' where id = 1;
$$;

create or replace function tests.make_team_member(p_name text, p_label text default 'Ops')
returns uuid language sql as $$
  insert into public.team_member (name, email, discord_user_id, job_title)
  values (p_name, lower(replace(p_name, ' ', '.')) || '@example.com', tests.rand_discord(), p_label)
  returning id;
$$;

create or replace function tests.make_domain(p_name text, p_status text default 'Live')
returns uuid language plpgsql as $$
declare v uuid; v_ops uuid; v_lead uuid;
begin
  insert into public.domain (name, status, alert_discord_channel_id, test_discord_channel_id, test_email)
  values (p_name, p_status, tests.rand_discord(), tests.rand_discord(), 'test-inbox@example.com')
  returning id into v;
  v_ops := tests.make_team_member(p_name || ' Ops', 'Ops');
  v_lead := tests.make_team_member(p_name || ' Lead', 'Lead');
  insert into public.domain_team (domain_id, team_member_id, role) values (v, v_ops, 'Operations'), (v, v_lead, 'Escalation');
  return v;
end $$;

create or replace function tests.make_instructor(p_name text, p_verified boolean default true, p_is_test boolean default false)
returns uuid language sql as $$
  insert into public.instructor (full_name, primary_email, discord_user_id, discord_channel_id, verified_at, is_test)
  values (p_name, lower(replace(p_name, ' ', '.')) || '@example.org', tests.rand_discord(), tests.rand_discord(),
          case when p_verified then now() end, p_is_test)
  returning id;
$$;

-- Module with the standard 2-class pattern (Sun 9:00–13:00 live, Thu 18:00–20:00 review), an owner
-- and one resource.
create or replace function tests.make_module(p_domain uuid, p_name text, p_order int default 1, p_with_owner boolean default true)
returns uuid language plpgsql as $$
declare v uuid;
begin
  insert into public.module (domain_id, name, rotation_order) values (p_domain, p_name, p_order) returning id into v;
  insert into public.class_pattern_item (module_id, class_type, title_template, day_offset, start_time_pt, duration_minutes, sort_order)
  values (v, 'Live class', '{module}: Live class', 0, '09:00', 240, 1),
         (v, 'Assignment review', '{module}: Assignment review', 4, '18:00', 120, 2);
  insert into public.module_resource (module_id, title, url) values (v, p_name || ' module page', 'https://example.com/' || v);
  if p_with_owner then
    insert into public.module_owner (module_id, team_member_id) values (v, tests.make_team_member(p_name || ' Owner', 'PM'));
  end if;
  return v;
end $$;

create or replace function tests.rank(p_module uuid, variadic p_instructors uuid[])
returns void language plpgsql as $$
declare i int;
begin
  delete from public.module_ranking where module_id = p_module;
  for i in 1 .. array_length(p_instructors, 1) loop
    insert into public.module_ranking (module_id, instructor_id, rank) values (p_module, p_instructors[i], i);
  end loop;
end $$;

-- Module week + classes from the module's pattern (week_start_date is the Sunday).
create or replace function tests.make_week(p_module uuid, p_week_start date, p_cohort text default '')
returns uuid language plpgsql as $$
declare v uuid; p record; v_mod text;
begin
  select name into v_mod from public.module where id = p_module;
  insert into public.module_week (module_id, week_start_date, cohort) values (p_module, p_week_start, p_cohort)
  returning id into v;
  for p in select * from public.class_pattern_item where module_id = p_module and cohort_id is null order by sort_order loop
    insert into public.class_session (module_week_id, pattern_item_id, class_type, title, starts_at, ends_at)
    values (v, p.id, p.class_type, replace(replace(p.title_template, '{module}', v_mod), '{class_type}', p.class_type),
            public.pt_to_utc(p_week_start + p.day_offset, p.start_time_pt),
            public.pt_to_utc(p_week_start + p.day_offset, p.start_time_pt) + make_interval(mins => p.duration_minutes));
  end loop;
  return v;
end $$;

-- Raw booking with slots for every planned class (bypasses the engine; for rule tests).
create or replace function tests.raw_book(p_mw uuid, p_instructor uuid)
returns uuid language plpgsql as $$
declare v uuid;
begin
  insert into public.booking (module_week_id, instructor_id, confirmed_via) values (p_mw, p_instructor, 'Manual') returning id into v;
  insert into public.booking_slot (booking_id, class_id, instructor_id, time_range)
  select v, c.id, p_instructor, tstzrange(c.starts_at, c.ends_at, '[)')
    from public.class_session c where c.module_week_id = p_mw and c.status = 'Planned';
  return v;
end $$;

-- A ready-to-run scenario: domain + module (owner, pattern, resource) + N verified instructors ranked
-- in order + one module week starting p_week (Sunday). Returns ids as jsonb:
-- {domain, module, mw, owner, ops, lead, i1, i2, …}
create or replace function tests.scenario(p_domain_name text, p_status text default 'Live', p_week date default '2027-01-31',
  p_n int default 3, p_module_name text default 'Concurrency')
returns jsonb language plpgsql as $$
declare
  v_dom uuid; v_mod uuid; v_mw uuid; v jsonb; i int; v_ids uuid[] := '{}'; v_i uuid;
begin
  perform tests.company();
  v_dom := tests.make_domain(p_domain_name, p_status);
  v_mod := tests.make_module(v_dom, p_module_name || ' ' || p_domain_name);
  for i in 1 .. p_n loop
    v_i := tests.make_instructor(p_domain_name || ' Instr' || i);
    v_ids := v_ids || v_i;
  end loop;
  perform tests.rank(v_mod, variadic v_ids);
  v_mw := tests.make_week(v_mod, p_week);
  v := jsonb_build_object('domain', v_dom, 'module', v_mod, 'mw', v_mw,
    'owner', (select team_member_id from public.module_owner where module_id = v_mod limit 1),
    'ops', (select team_member_id from public.domain_team where domain_id = v_dom and role = 'Operations' limit 1),
    'lead', (select team_member_id from public.domain_team where domain_id = v_dom and role = 'Escalation' limit 1));
  for i in 1 .. p_n loop
    v := v || jsonb_build_object('i' || i, v_ids[i]);
  end loop;
  return v;
end $$;

-- Run the hourly check at p_at and keep that as "now" for app actions that follow in the test.
create or replace function tests.tick(p_domain uuid, p_at timestamptz)
returns jsonb language plpgsql as $$
begin
  perform set_config('app.test_now', p_at::text, true);
  return public.engine_tick(p_domain, p_at);
end $$;

create or replace function tests.at(p_at timestamptz)
returns void language sql as $$ select set_config('app.test_now', p_at::text, true); $$;

-- Token of the latest request (any kind) for this instructor/module week offering p_answer.
create or replace function tests.token(p_mw uuid, p_instructor uuid, p_answer text)
returns text language sql as $$
  select l.token from public.response_link l join public.request r on r.id = l.request_id
   where r.module_week_id = p_mw and r.instructor_id = p_instructor and l.answer = p_answer
   order by r.created_at desc limit 1;
$$;

create or replace function tests.click(p_mw uuid, p_instructor uuid, p_answer text)
returns text language sql as $$
  select public.record_response(tests.token(p_mw, p_instructor, p_answer)) ->> 'result';
$$;

create or replace function tests.asking(p_mw uuid)
returns text language sql as $$
  select i.full_name from public.request r join public.instructor i on i.id = r.instructor_id
   where r.module_week_id = p_mw and r.kind = 'Outreach' and r.status in ('Queued', 'Sent', 'Reminded');
$$;

create or replace function tests.msgs(p_mw uuid, p_template text)
returns int language sql as $$
  select count(*)::int from public.message where module_week_id = p_mw and template_id = p_template;
$$;

create or replace function tests.dmsgs(p_domain uuid, p_template text)
returns int language sql as $$
  select count(*)::int from public.message where domain_id = p_domain and template_id = p_template;
$$;

create or replace function tests.open_items(p_domain uuid, p_type text)
returns int language sql as $$
  select count(*)::int from public.attention_item where domain_id = p_domain and type = p_type and status <> 'Done';
$$;

create or replace function tests.mw_status(p_mw uuid)
returns text language sql as $$ select status from public.module_week where id = p_mw; $$;

create or replace function tests.booked(p_mw uuid)
returns text language sql as $$
  select i.full_name from public.booking b join public.instructor i on i.id = b.instructor_id
   where b.module_week_id = p_mw and b.status = 'Active';
$$;

grant usage on schema tests to authenticated, anon;
grant execute on all functions in schema tests to authenticated, anon;

