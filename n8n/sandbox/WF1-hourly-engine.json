{
  "name": "[Production] WF1 Hourly engine",
  "nodes": [
    {
      "id": "e6a8e099-ecd5-49c6-9ee2-777e44881f99",
      "name": "Note: overview",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -60,
        -440
      ],
      "parameters": {
        "content": "## WF1 Hourly engine\n1. `engine_tick_all(null)` runs every check for every domain (all decisions are in the database).\nWF4 delivers what it queued within 6 minutes.\n\nTyped replies (Gmail and Discord) are read by WF4 every 6 minutes (decision 270).\n\n**Edit only the Config node.**",
        "height": 380,
        "width": 700,
        "color": 5
      }
    },
    {
      "id": "e5a5a4ae-9b78-47fa-a835-5d9a17be3c31",
      "name": "Every hour",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1,
              "triggerAtMinute": 0
            }
          ]
        }
      }
    },
    {
      "id": "3728288d-3c2a-442e-be90-f8de2519b0a8",
      "name": "Config",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "// EDIT THESE VALUES (one place per workflow). No other node needs changing.\n// The poke key is not here: it lives only in the \"Poke secret\" credential (decision 316).\nconst supabaseUrl = 'https://abcdefghijklmnopqrst.supabase.co';      // Supabase project URL\nconst pokeUrl = 'https://your-instance.app.n8n.cloud/webhook/sandbox-sme-poke';          // WF4 \"Action runner\" production webhook URL\n\nreturn [{ json: {\n  supabaseUrl: supabaseUrl.replace(/\\/+$/, ''),\n  pokeUrl,\n} }];"
      }
    },
    {
      "id": "8b502e79-80ee-4e02-acd0-4dc60847a6f7",
      "name": "Run engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/engine_tick_all",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_now: null }) }}",
        "options": {
          "timeout": 300000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "name": "Supabase Sandbox"
        }
      }
    }
  ],
  "connections": {
    "Every hour": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "Run engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run engine": {
      "main": [
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false,
  "pinData": {},
  "meta": {},
  "tags": [
    {
      "name": "Sandbox"
    }
  ]
}
