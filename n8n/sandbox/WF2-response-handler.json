      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.pokeUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-poke-key",
              "value": "={{ $('Config').first().json.pokeKey }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{}",
        "options": {
          "timeout": 15000
        }
      },
      "onError": "continueRegularOutput",
      "executeOnce": true
    },
    {
      "id": "e28be6bb-378e-46a0-91ad-94217ed1e9f4",
      "name": "Respond with error page",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        520
      ],
      "parameters": {
        "respondWith": "text",
        "responseBody": "<!doctype html><html><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Please try again</title></head><body style=\"font-family:Arial,Helvetica,sans-serif;max-width:480px;margin:40px auto;padding:0 16px;color:#1f2328;line-height:1.5\"><h2>Sorry, something went wrong</h2><p>Your answer may not have been saved. Please try the link again in a few minutes. If it still does not work, reply to the message or contact the scheduling team.</p></body></html>",
        "options": {
          "responseCode": 503,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html; charset=utf-8"
              },
              {
                "name": "Cache-Control",
                "value": "no-store"
              }
            ]
          }
        }
      }
    },
    {
      "id": "4c0260b4-02ab-4a68-b3f3-75e1752231a0",
      "name": "Mark execution failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        520
      ],
      "parameters": {
        "jsCode": "// The visitor already got the friendly error page. Fail the execution so WF5 records it and alerts the admin.\nconst r = $('Render page').isExecuted ? 'response_page' : 'submit_response_page';\nconst e = $input.first().json.error;\nthrow new Error('Confirm page failed (' + r + '): ' + (typeof e === 'string' ? e : (e && e.message) || 'unknown error'));"
      }
    },
    {
      "id": "ec4bc10f-d1ce-4d50-9097-70b85f1f704f",
      "name": "Note: errors",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        640,
        640
      ],
      "parameters": {
        "content": "Error outputs of both database calls share one friendly error page (HTTP 503). Nothing is retried automatically: the instructor can press the button again.",
        "height": 160,
        "width": 680,
        "color": 3
      }
    }
