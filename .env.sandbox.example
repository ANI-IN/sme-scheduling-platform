# The Sandbox values you already have (docs/CONFIGURATION.md). Copy this file to .env.sandbox (ignored by git)
# and add the one secret: DATABASE_URL with your Sandbox database password. Then run
#   npm run configure:sandbox -w scripts
DATABASE_URL=REPLACE_WITH_SANDBOX_SESSION_POOLER_URL_WITH_YOUR_PASSWORD
ALLOWED_EMAIL_DOMAIN=yourcompany.com
RESPONSE_BASE_URL=https://your-instance.app.n8n.cloud/webhook/sandbox-respond
APP_BASE_URL=http://localhost:5173
SANDBOX_ALLOWED_DISCORD_SERVERS=1200000000000000010
SANDBOX_ALLOWED_EMAIL_DOMAINS=yourcompany.com
