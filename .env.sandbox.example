# The Production values you already have (docs/CONFIGURATION.md). There is one environment, Production, which is
# the old Sandbox under a new name; this file keeps its old name on purpose.
# Copy this file to .env.production (ignored by git), the live settings file. Then:
#   1. add the one secret: DATABASE_URL with your database password;
#   2. change APP_BASE_URL to https://your-app.vercel.app (configure:production needs an https address).
# Then run
#   npm run configure:production -w scripts
# (npm run configure:sandbox -w scripts is kept only to roll back the switch to Production.)
# SANDBOX_ALLOWED_DISCORD_SERVERS and SANDBOX_ALLOWED_EMAIL_DOMAINS are internal names of the old allow lists and are
# not used in Production. The path of RESPONSE_BASE_URL keeps the word sandbox on purpose.
DATABASE_URL=REPLACE_WITH_SANDBOX_SESSION_POOLER_URL_WITH_YOUR_PASSWORD
ALLOWED_EMAIL_DOMAIN=yourcompany.com
RESPONSE_BASE_URL=https://your-instance.app.n8n.cloud/webhook/sandbox-respond
APP_BASE_URL=http://localhost:5173
SANDBOX_ALLOWED_DISCORD_SERVERS=1200000000000000010
SANDBOX_ALLOWED_EMAIL_DOMAINS=yourcompany.com
