{
  "name": "sme-scheduling-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "app",
    "scripts",
    "e2e"
  ],
  "scripts": {
    "db:start": "node node_modules/supabase/dist/supabase.js start",
    "db:stop": "node node_modules/supabase/dist/supabase.js stop",
    "db:reset": "node node_modules/supabase/dist/supabase.js db reset",
    "db:test": "node node_modules/supabase/dist/supabase.js test db",
    "db:login": "node node_modules/supabase/dist/supabase.js login",
    "db:link": "node node_modules/supabase/dist/supabase.js link --project-ref",
    "db:push": "node node_modules/supabase/dist/supabase.js db push",
    "lint": "npm run lint -w app",
    "typecheck": "npm run typecheck -w app && npm run typecheck -w scripts && npm run typecheck -w e2e",
    "test": "npm run test -w app",
    "build": "npm run build -w app",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mock": "npm run mock -w scripts --",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run check-build -w scripts",
    "help:screenshots": "npm run demo -w scripts -- snapshot && npm run demo -w scripts -- load && (npm run help-shots -w scripts; s=$?; npm run demo -w scripts -- restore; exit $s)",
    "e2e": "tsx scripts/src/e2e-run.ts"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "supabase": "^3.1.0"
  }
}
